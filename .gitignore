# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception

/.cache
/compile_commands.json
/build

# ignore emacs temp files
*~
\#*\#

# ignore vscode settings
.vscode

# ignore vim swap files
.swp

# ignore merge/patch backup files
.orig

# build artifacts from Makefile workflow
/.build/
/.install/
/.update-submodules

# uv lock file (generated, not committed)
/uv.lock

# Python virtual environment
.venv/

# Claude Code local settings
/.claude/

# specgen dependency files from make wording
/papers/.deps/

# A paper's latexmk dependency files, which name this machine's paths, and a
# local pyenv pin; the paper Makefile chooses its own Python.
/papers/*/.deps/
/papers/*/.python-version
